{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "_cspNote": "L1 (audit #4): CSP tightened as far as safely possible. img-src/font-src no longer carry a bare https: — every host below was verified by grepping src/ + api/ for the hosts the app actually calls. script-src still needs 'unsafe-inline': the Google OAuth callback (api/auth/callback/google.ts) serves inline <script> blocks that embed per-request dynamic JSON (the signed-in profile + returnTo), so no static hash can ever match them, and vercel.json headers are static strings — no per-response nonce can be generated. Removing 'unsafe-inline' would break Google sign-in outright. style-src keeps 'unsafe-inline' for the <style> blocks in src/components/events/ImageUploadField.tsx. connect-src keeps api.razorpay.com even though only the server calls it directly: Razorpay's checkout.js (loaded in-page) makes its own API calls from page context, and dropping it risks breaking checkout with no live way to prove otherwise. img-src keeps lh3.googleusercontent.com: Google profile pictures (googleUser.picture) are served from there and rendered as <img> avatars. Supabase hosts are wildcarded (*.supabase.co) because the project URL comes from VITE_SUPABASE_URL at runtime, not from code.",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://images.unsplash.com https://*.supabase.co https://lh3.googleusercontent.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://api.razorpay.com https://checkout.razorpay.com https://countriesnow.space https://ipwho.is https://ipapi.co https://nominatim.openstreetmap.org https://*.supabase.co wss://*.supabase.co; frame-src 'self' https://checkout.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth?endpoint=login"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth?endpoint=signup"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth?endpoint=logout"
    },
    {
      "source": "/api/auth/reset",
      "destination": "/api/auth?endpoint=reset"
    },
    {
      "source": "/api/auth/verify-email",
      "destination": "/api/auth?endpoint=verify-email"
    },
    {
      "source": "/api/auth/resend-verification",
      "destination": "/api/auth?endpoint=resend-verification"
    },
    {
      "source": "/api/me",
      "destination": "/api/auth?endpoint=me"
    },
    {
      "source": "/api/create-order",
      "destination": "/api/payments?action=create-order"
    },
    {
      "source": "/api/verify-payment",
      "destination": "/api/payments?action=verify-payment"
    },
    {
      "destination": "/index.html",
      "source": "/((?!api/).*)"
    }
  ]
}
