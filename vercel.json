{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' data: https:; connect-src 'self' https: wss:; frame-src 'self' https://checkout.razorpay.com https://api.razorpay.com; object-src 'none'; base-uri 'self'; form-action 'self' https://accounts.google.com; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/login",
      "destination": "/api/auth?endpoint=login"
    },
    {
      "source": "/api/auth/signup",
      "destination": "/api/auth?endpoint=signup"
    },
    {
      "source": "/api/auth/logout",
      "destination": "/api/auth?endpoint=logout"
    },
    {
      "source": "/api/auth/reset",
      "destination": "/api/auth?endpoint=reset"
    },
    {
      "source": "/api/me",
      "destination": "/api/auth?endpoint=me"
    },
    {
      "source": "/api/create-order",
      "destination": "/api/payments?action=create-order"
    },
    {
      "source": "/api/verify-payment",
      "destination": "/api/payments?action=verify-payment"
    },
    {
      "destination": "/index.html",
      "source": "/((?!api/).*)"
    }
  ]
}
