# Locora Hyperlocal Discovery Environment Variables

# Google OAuth 2.0 Credentials (Direct Google Identity Services authentication)
# Set up a Web application OAuth 2.0 Client ID in Google Cloud Console:
# https://console.cloud.google.com/apis/credentials
# In "Authorized JavaScript origins", add your local and deployment origins:
#   - http://localhost:3000
#   - https://locora-hyperlocal.vercel.app
#   - https://vecna-verse.vercel.app
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Optional: Google Gemini API Key for AI Google Search Grounding to find real-time events across any city
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=

# Optional: Ticketmaster API Key for pulling live concert & venue events
# Get your API key at: https://developer.ticketmaster.com/
TICKETMASTER_API_KEY=

# Server Port (AI Studio environment requires 3000)
PORT=3000

# Client Configuration
# Base API URL (defaults to /api when hosted full-stack on the same port)
VITE_API_BASE_URL=/api

# Set to "true" to run with client-side demo storage (localStorage) or leave empty/"false" for full-stack Express backend
VITE_USE_MOCK_API=false